# --- Seguridad (EP1) ---
COGNITO_ISSUER_URI=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_XXXXXXX
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
FRONTEND_ORIGIN=http://localhost:3000
PORT=8080

# --- Base de datos (EP2) ---
DB_URL=jdbc:postgresql://localhost:5432/cometranqui
DB_USER=cometranqui
DB_PASS=cometranqui

# --- Kafka (EP2) ---
# Local: localhost:9092 (listener EXTERNAL del docker-compose). AWS: <EIP-del-broker>:9092
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_USER=cometranqui
KAFKA_PASS=cometranqui-local
# Solo para docker-compose: host anunciado en advertised.listeners
KAFKA_ADVERTISED_HOST=localhost

# --- Scraper (EP2) ---
# Lambda que invoca POST /api/admin/scraper/run
SCRAPER_LAMBDA_NAME=cometranqui-scraper
AWS_REGION=us-east-1
# Variables de la Lambda / ejecución local del scraper
# Fuentes separadas por coma: JUMBO, SANTA_ISABEL, MOCK
FUENTES_ACTIVAS=JUMBO,SANTA_ISABEL
SCRAPER_MAX_PAGINAS=3
SCRAPER_PAUSA_MS=1500
